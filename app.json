{
  "expo": {
    "name": "Svara Yoga",
    "slug": "svara-yoga",
    "version": "2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ocsike.svarayoga",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Svara Yoga are nevoie de locație pentru a calcula orele corecte de respirație în funcție de răsărit.",
        "NSLocationAlwaysUsageDescription": "Svara Yoga are nevoie de locație în fundal pentru notificări precise."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ocsike.svarayoga",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "VIBRATE",
        "com.android.vending.BILLING"
      ],
      "versionCode": 106
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Svara Yoga are nevoie de locație pentru acuratețea exercițiilor."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "1.9.24",
            "uncompressedNativeLibsEnabled": false
          }
        }
      ],
      "react-native-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "e1d05aad-f013-4df4-99fb-2e6e3d8ae160"
      }
    }
  }
}
